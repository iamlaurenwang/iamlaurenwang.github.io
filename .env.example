# Firebase 設定（值請到 Firebase Console → 專案設定 取得）
# 本機開發：複製此檔為 .env 並填入實際值
# CI/CD：於 GitHub repo Settings → Secrets and variables → Actions 設定同名變數
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# reCAPTCHA v3（site key 為公開值，CI 請放 repo Variables 而非 Secrets）
VITE_RECAPTCHA_V3_SITE_KEY=

# Google Analytics 4（Measurement ID 為公開值，CI 請放 repo Variables 而非 Secrets）
# 留空即停用追蹤，不會報錯
VITE_GA_MEASUREMENT_ID=
